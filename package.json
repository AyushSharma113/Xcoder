{
  "name": "xcoder",
  "version": "1.0.0",
  "type": "module",
  "description": "A terminal-based coding agent built from scratch",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "openai": "^7.34.0"
  }
}
